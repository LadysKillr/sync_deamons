{
  "name": "paseo-sync",
  "private": true,
  "version": "0.1.0",
  "description": "Plugin Paseo : synchronisation chiffrée et bidirectionnelle entre daemons (plugins, versions, réglages, agents, fichiers), par groupes.",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "README.md",
    "README.fr.md",
